  {"sop": "trends", "heading": "<heading>", "msq": "<question id or null>", "point": "<one plain line>", "facts": ["<id>"], "secondary": "<pool key or null>", "longtail": "<long-tail id or null>", "terms": ["<term>"], "snippet": "<guest point id or null>"},
