# Copy the real values into Vercel's project env vars (and/or a local .env for `npm run dev`).
# Never commit real values.

# Neon Postgres connection string (from the Neon console: Dashboard -> Connection Details)
DATABASE_URL=

# LEGACY, only for `--direct` agent builds that cannot use a per-install token (any long random string).
# Proxy builds authenticate with their own token, so this can stay empty.
INGEST_KEY=

# Password for the dashboard login page (any long random string)
ADMIN_PASSWORD=

# Random string used to sign the dashboard session cookie (any long random string)
SESSION_SECRET=

# --- LLM proxy (POST /api/v1/chat/completions) ---------------------------------------------
# The real DeepSeek key lives ONLY here (Vercel env), never in the shipped agent.
DEEPSEEK_API_KEY=
# Optional (defaults shown):
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ALLOWED_MODELS=deepseek-chat            # comma-separated allowlist
# PROXY_MAX_CALLS_PER_MIN=60            # per-token rate limit
# PROXY_MAX_BODY_CHARS=400000            # prompt size cap
# PROXY_MAX_TOKENS_CAP=20000              # clamp on max_tokens per call
# PROXY_UPSTREAM_TIMEOUT_MS=110000        # must stay below the route's 120 s maxDuration
# GLOBAL_DAILY_BUDGET_USD=                # optional hard cap across all installs (UTC day)
