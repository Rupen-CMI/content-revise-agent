# Copy to .env and fill in. NEVER commit the real .env.
# DeepSeek. Dev runs call DeepSeek directly with this key. Distribution builds do NOT ship it
# (they use the Vercel LLM proxy, see monitor/README.md); only `--direct` builds bake it.
DEEPSEEK_API_KEY=

# Postgres (dev/export scripts only; the packaged app ships catalog.sqlite)
DB_URL=

# Usage monitoring (optional) -- see monitor/README.md.
# Get the ingest key from the dashboard owner; the URL is the deployed Vercel app.
MONITOR_URL=
# Only for --direct builds. Proxy builds (the default) use the per-user MONITOR_PROXY_TOKEN below
# for telemetry too, so no shared ingest key ships to end users.
MONITOR_INGEST_KEY=

# YOUR OWN dev token (cmi_...), so runs from this folder report to the dashboard. Mint it with
#   cd monitor && npm run token -- create "<Your name> (dev)" 1
# It is NEVER baked into a package: build_package.py refuses it. Each end user gets their own token,
# passed at build time: set MONITOR_PROXY_TOKEN in the shell (or --proxy-token) when you build their copy.
MONITOR_PROXY_TOKEN=
